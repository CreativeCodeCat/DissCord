# Example settings for the DissCord server and client.
#
# Copy this file to `.env` and change the values you need. The server and client do not read
# `.env` yet: set these in your shell (`export NAME=value`) or on the command line for now.

# --- Server ---

# Address other servers and clients use to reach this server. Leave unset to use the LAN address
# (only used when running a single server; a group uses each server's own LAN address).
DISSCORD_ADVERTISE=192.168.1.20:7878

# UDP port for finding servers on the local network. Each server in a group uses the next one up.
DISSCORD_DISCOVERY_PORT=7879

# Seconds between asking known servers for their lists.
DISSCORD_EXCHANGE_SECS=30

# Servers to start from, comma separated. For finding servers across the internet.
# A group's first server uses these and knows every other server in the group.
DISSCORD_PEERS=127.0.0.1:7878,203.0.113.5:7878

# Server command line, for reference:
#   server [ADDR] [DB_PATH] [AUTH_ADDR] [COUNT]
#   e.g. server 127.0.0.1:7878 disscord.db 127.0.0.1:7900 3

# --- Client ---

# Address of the auth service that holds accounts.
DISSCORD_AUTH=127.0.0.1:7900
